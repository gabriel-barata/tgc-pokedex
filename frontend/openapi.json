{
  "openapi": "3.1.0",
  "info": {
    "title": "TCG Pokédex",
    "version": "0.1.0"
  },
  "paths": {
    "/healthz": {
      "get": {
        "summary": "Healthz",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/sets": {
      "get": {
        "summary": "List Sets",
        "description": "Every set grouped by series, newest release first, with the owner's tracking.",
        "operationId": "list_sets_api_sets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SeriesEntry"
                  },
                  "type": "array",
                  "title": "Response List Sets Api Sets Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/sets/{set_id}/ownership": {
      "get": {
        "summary": "Get Ownership",
        "description": "Every card of the set with the owner's quantity per variant and its flags.",
        "operationId": "get_ownership_api_sets__set_id__ownership_get",
        "parameters": [
          {
            "name": "set_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Set Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetOwnership"
                }
              }
            }
          },
          "404": {
            "description": "The set is not in the catalog"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sets/{set_id}/tracking": {
      "get": {
        "summary": "Get Tracking",
        "operationId": "get_tracking_api_sets__set_id__tracking_get",
        "parameters": [
          {
            "name": "set_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Set Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetTracking"
                }
              }
            }
          },
          "404": {
            "description": "The set is not in the catalog"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Track Set",
        "description": "Track the set and, when it was untracked, download its images afterwards.",
        "operationId": "track_set_api_sets__set_id__tracking_put",
        "parameters": [
          {
            "name": "set_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Set Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetTracking"
                }
              }
            }
          },
          "404": {
            "description": "The set is not in the catalog"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Untrack Set",
        "description": "Untrack the set. Its cached images stay, and a running download goes on.",
        "operationId": "untrack_set_api_sets__set_id__tracking_delete",
        "parameters": [
          {
            "name": "set_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Set Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetTracking"
                }
              }
            }
          },
          "404": {
            "description": "The set is not in the catalog"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/images/cards/{card_id}/{size}": {
      "get": {
        "summary": "Card Image",
        "operationId": "card_image_api_images_cards__card_id___size__get",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Card Id"
            }
          },
          {
            "name": "size",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/CardSize"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/webp": {}
            }
          },
          "304": {
            "description": "The cached copy is current"
          },
          "404": {
            "description": "The image is not cached"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/images/sets/{set_id}/{kind}": {
      "get": {
        "summary": "Set Artwork",
        "operationId": "set_artwork_api_images_sets__set_id___kind__get",
        "parameters": [
          {
            "name": "set_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Set Id"
            }
          },
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/ArtworkKind"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "image/webp": {}
            }
          },
          "304": {
            "description": "The cached copy is current"
          },
          "404": {
            "description": "The image is not cached"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cards/{card_id}/ownership/{variant}/increment": {
      "post": {
        "summary": "Increment",
        "description": "Add one copy of the card's variant.",
        "operationId": "increment_api_cards__card_id__ownership__variant__increment_post",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Card Id"
            }
          },
          {
            "name": "variant",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Variant"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardOwnership"
                }
              }
            }
          },
          "404": {
            "description": "The card is not in the catalog"
          },
          "409": {
            "description": "The variant already has 999 copies"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cards/{card_id}/ownership/{variant}/decrement": {
      "post": {
        "summary": "Decrement",
        "description": "Remove one copy of the card's variant. A variant with none stays at 0.",
        "operationId": "decrement_api_cards__card_id__ownership__variant__decrement_post",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Card Id"
            }
          },
          {
            "name": "variant",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Variant"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardOwnership"
                }
              }
            }
          },
          "404": {
            "description": "The card is not in the catalog"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cards/{card_id}/ownership/{variant}": {
      "put": {
        "summary": "Set Quantity",
        "description": "Record exactly this many copies of the card's variant.",
        "operationId": "set_quantity_api_cards__card_id__ownership__variant__put",
        "parameters": [
          {
            "name": "card_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Card Id"
            }
          },
          {
            "name": "variant",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Variant"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuantityUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardOwnership"
                }
              }
            }
          },
          "404": {
            "description": "The card is not in the catalog"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArtworkKind": {
        "type": "string",
        "enum": [
          "logo",
          "symbol"
        ],
        "title": "ArtworkKind"
      },
      "CardOwnership": {
        "properties": {
          "card_id": {
            "type": "string",
            "title": "Card Id"
          },
          "variants": {
            "items": {
              "$ref": "#/components/schemas/VariantQuantity"
            },
            "type": "array",
            "title": "Variants"
          },
          "owned": {
            "type": "boolean",
            "title": "Owned"
          },
          "wanted_version_missing": {
            "type": "boolean",
            "title": "Wanted Version Missing"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "card_id",
          "variants",
          "owned",
          "wanted_version_missing"
        ],
        "title": "CardOwnership",
        "description": "A card's quantity per listed variant, in canonical order, and its flags."
      },
      "CardSize": {
        "type": "string",
        "enum": [
          "small",
          "large"
        ],
        "title": "CardSize"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthStatus": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "HealthStatus"
      },
      "QuantityUpdate": {
        "properties": {
          "quantity": {
            "type": "integer",
            "maximum": 999.0,
            "minimum": 0.0,
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "quantity"
        ],
        "title": "QuantityUpdate",
        "description": "The number of copies to record for one variant of a card."
      },
      "SeriesEntry": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "sets": {
            "items": {
              "$ref": "#/components/schemas/SetEntry"
            },
            "type": "array",
            "title": "Sets"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "sets"
        ],
        "title": "SeriesEntry"
      },
      "SetCompletion": {
        "properties": {
          "owned": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Owned"
          },
          "so_normal": {
            "type": "integer",
            "minimum": 0.0,
            "title": "So Normal"
          },
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total"
          },
          "complete": {
            "type": "boolean",
            "title": "Complete"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "owned",
          "so_normal",
          "total",
          "complete"
        ],
        "title": "SetCompletion",
        "description": "How many of a set's cards the owner has, and how many only in Normal."
      },
      "SetEntry": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "release_date": {
            "type": "string",
            "format": "date",
            "title": "Release Date"
          },
          "card_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Card Count"
          },
          "has_logo": {
            "type": "boolean",
            "title": "Has Logo"
          },
          "has_symbol": {
            "type": "boolean",
            "title": "Has Symbol"
          },
          "tracked": {
            "type": "boolean",
            "title": "Tracked"
          },
          "downloading": {
            "type": "boolean",
            "title": "Downloading"
          },
          "completion": {
            "$ref": "#/components/schemas/SetCompletion"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name",
          "release_date",
          "card_count",
          "has_logo",
          "has_symbol",
          "tracked",
          "downloading",
          "completion"
        ],
        "title": "SetEntry",
        "description": "A set as one owner sees it. `has_logo` and `has_symbol` mean cached."
      },
      "SetOwnership": {
        "properties": {
          "set_id": {
            "type": "string",
            "title": "Set Id"
          },
          "completion": {
            "$ref": "#/components/schemas/SetCompletion"
          },
          "cards": {
            "items": {
              "$ref": "#/components/schemas/CardOwnership"
            },
            "type": "array",
            "title": "Cards"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "set_id",
          "completion",
          "cards"
        ],
        "title": "SetOwnership",
        "description": "Every card of a set, by card id, with the owner's quantities and flags."
      },
      "SetTracking": {
        "properties": {
          "set_id": {
            "type": "string",
            "title": "Set Id"
          },
          "tracked": {
            "type": "boolean",
            "title": "Tracked"
          },
          "total_cards": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total Cards"
          },
          "cached": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Cached"
          },
          "unavailable": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Unavailable"
          },
          "downloading": {
            "type": "boolean",
            "title": "Downloading"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "set_id",
          "tracked",
          "total_cards",
          "cached",
          "unavailable",
          "downloading"
        ],
        "title": "SetTracking",
        "description": "A set's tracking state for one owner, and its image progress."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Variant": {
        "type": "string",
        "enum": [
          "normal",
          "reverse",
          "holo",
          "first_edition",
          "w_promo"
        ],
        "title": "Variant",
        "description": "A printing a card exists in. Declaration order is the canonical storage order."
      },
      "VariantQuantity": {
        "properties": {
          "variant": {
            "$ref": "#/components/schemas/Variant"
          },
          "quantity": {
            "type": "integer",
            "maximum": 999.0,
            "minimum": 0.0,
            "title": "Quantity"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "variant",
          "quantity"
        ],
        "title": "VariantQuantity",
        "description": "How many copies of one variant of a card the owner has."
      }
    }
  }
}
